{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user profile data including game statistics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "maxLength": 50 },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "totalKills": { "type": "integer" },
        "totalWins": { "type": "integer" },
        "totalMatches": { "type": "integer" },
        "exploredGovs": { "type": "array", "description": "List of governorate IDs explored" },
        "lastActive": { "type": "string", "format": "date-time" },
        "level": { "type": "integer" }
      },
      "required": ["uid", "displayName"]
    },
    "ForexAccount": {
      "title": "Forex Trading Account",
      "description": "User's virtual trading account linked to combat performance.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "equity": { "type": "number" },
        "margin": { "type": "number" },
        "freeMargin": { "type": "number" },
        "leverage": { "type": "integer" },
        "currency": { "type": "string", "enum": ["USD", "YER"] },
        "totalCombatEarnings": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance", "currency"]
    },
    "ForexTrade": {
      "title": "Forex Trade",
      "description": "Individual trading position record.",
      "type": "object",
      "properties": {
        "tradeId": { "type": "string" },
        "userId": { "type": "string" },
        "pair": { "type": "string" },
        "type": { "type": "string", "enum": ["BUY", "SELL"] },
        "lotSize": { "type": "number" },
        "entryPrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "profit": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "openTime": { "type": "string", "format": "date-time" },
        "closeTime": { "type": "string", "format": "date-time" }
      },
      "required": ["tradeId", "userId", "pair", "type", "lotSize", "entryPrice", "status", "openTime"]
    },
    "Match": {
      "title": "Game Match Record",
      "description": "Result of a Battle Royale match.",
      "type": "object",
      "properties": {
        "matchId": { "type": "string" },
        "userId": { "type": "string" },
        "kills": { "type": "integer" },
        "won": { "type": "boolean" },
        "governorateId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["matchId", "userId", "kills", "won"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID."
    },
    "/forexAccounts/{userId}": {
      "schema": "ForexAccount",
      "description": "Trading accounts indexed by UID."
    },
    "/forexTrades/{tradeId}": {
      "schema": "ForexTrade",
      "description": "Trading positions."
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Match history."
    }
  }
}
