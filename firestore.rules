rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Master Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'totalKills', 'totalWins']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'totalKills', 'totalWins', 'totalMatches', 'exploredGovs', 'lastActive', 'level']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.totalKills is int && data.totalKills >= 0 &&
             data.totalWins is int && data.totalWins >= 0 &&
             (data.email == null || data.email is string) &&
             (data.lastActive == null || data.lastActive == request.time);
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['matchId', 'userId', 'kills', 'won', 'timestamp']) &&
             data.keys().hasOnly(['matchId', 'userId', 'kills', 'won', 'governorateId', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.kills is int && data.kills >= 0 &&
             data.won is bool &&
             data.timestamp == request.time;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // For leaderboard
      
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update Stats
        incoming().diff(existing()).affectedKeys().hasOnly(['totalKills', 'totalWins', 'totalMatches', 'exploredGovs', 'lastActive', 'level', 'displayName', 'photoURL'])
      );
      
      allow delete: if false; // Users cannot delete their accounts in-game
    }

    match /matches/{matchId} {
      allow get: if isSignedIn() && (isOwner(existing().userId));
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(matchId) && isValidMatch(incoming());
      allow update, delete: if false; // Matches are immutable
    }

    // Interaction Collections (e.g. for potential future features)
    match /test/connection {
      allow get: if true;
    }
  }
}
