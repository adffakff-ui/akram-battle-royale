rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'totalKills', 'totalWins', 'totalMatches', 'exploredGovs', 'lastActive', 'level']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 50 &&
             (data.get('email', '') is string && data.get('email', '').size() <= 100) &&
             (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 500);
    }

    function isValidForexAccount(data) {
      return data.keys().hasAll(['userId', 'balance', 'currency']) &&
             data.keys().hasOnly(['userId', 'balance', 'equity', 'margin', 'freeMargin', 'leverage', 'currency', 'totalCombatEarnings', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.balance is number &&
             data.currency in ['USD', 'YER'] &&
             (data.get('leverage', 100) is number);
    }

    function isValidForexTrade(data) {
      return data.keys().hasAll(['tradeId', 'userId', 'pair', 'type', 'lotSize', 'entryPrice', 'status', 'openTime']) &&
             data.keys().hasOnly(['tradeId', 'userId', 'pair', 'type', 'lotSize', 'entryPrice', 'currentPrice', 'stopLoss', 'takeProfit', 'profit', 'status', 'openTime', 'closeTime']) &&
             data.userId == request.auth.uid &&
             data.type in ['BUY', 'SELL'] &&
             data.status in ['OPEN', 'CLOSED'] &&
             data.lotSize is number && data.lotSize > 0 &&
             data.entryPrice is number &&
             isValidId(data.tradeId);
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['matchId', 'userId', 'kills', 'won']) &&
             data.keys().hasOnly(['matchId', 'userId', 'kills', 'won', 'governorateId', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.kills is number &&
             data.won is bool;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if true;
      allow list: if true; // Public leaderboards
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update profile stats
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'totalKills', 'totalWins', 'totalMatches', 'exploredGovs', 'lastActive', 'level'])
      );
    }

    match /forexAccounts/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidForexAccount(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidForexAccount(incoming()) && (
        // Action: Update balance/stats from game
        incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'equity', 'margin', 'freeMargin', 'totalCombatEarnings', 'updatedAt'])
      );
    }

    match /forexTrades/{tradeId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(tradeId) && isValidForexTrade(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidForexTrade(incoming()) && (
        // Action: Update trade status or live price
        incoming().diff(existing()).affectedKeys().hasOnly(['currentPrice', 'profit', 'status', 'closeTime'])
      );
    }

    match /matches/{matchId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidId(matchId) && isValidMatch(incoming());
      allow update: if false; // Matches are immutable
    }

    match /test/connection {
      allow get: if true;
    }
  }
}
